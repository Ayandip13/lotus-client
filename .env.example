# ==============================================================================
# Lotus Caterer - Catering Management System Environment Template
# ==============================================================================
# NOTE: Do NOT put actual credentials, secrets, or keys in this file.
# Copy this file to .env (or configure server/.env and client/.env) for local dev.

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/lotus_caterer

# --- Authentication (Prepared for Auth Phase) ---
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# --- File Storage (Prepared for Cloudinary Phase) ---
STORAGE_PROVIDER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
