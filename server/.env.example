# Server Environment Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/lotus_caterer

# Authentication Secret (Minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d

# File Storage Provider (Prepared for future Cloudinary integration)
STORAGE_PROVIDER=local
